from django.contrib import admin
from django.urls import path, include
from django.conf import settings
from django.conf.urls.static import static
from django.views.generic import RedirectView
from django.contrib.auth import views as auth_views
from django.contrib.auth.decorators import login_required
from django.http import HttpResponse
from .views import DashboardView

# Fonction pour vérifier si l'utilisateur est admin
def admin_required(user):
    return user.is_authenticated and user.is_staff

# URL de connexion accessible sans authentification
class PublicLoginView(auth_views.LoginView):
    template_name = 'registration/login.html'

# Vue de déconnexion personnalisée qui accepte GET et POST
class CustomLogoutView(auth_views.LogoutView):
    http_method_names = ['get', 'post', 'options']
    next_page = 'https://5nmg.l.time4vps.cloud:8446/immo/login/'  # Redirection explicite vers la page de login

# URLs d'authentification personnalisées
auth_urlpatterns = [
    path("test/", lambda request: HttpResponse("Test OK"), name="test"),
    path('login/', PublicLoginView.as_view(), name='login'),
    path('logout/', CustomLogoutView.as_view(), name='logout'),
    path('password_change/', auth_views.PasswordChangeView.as_view(), name='password_change'),
    path('password_change/done/', auth_views.PasswordChangeDoneView.as_view(), name='password_change_done'),
    path('password_reset/', auth_views.PasswordResetView.as_view(), name='password_reset'),
    path('password_reset/done/', auth_views.PasswordResetDoneView.as_view(), name='password_reset_done'),
    path('reset/<uidb64>/<token>/', auth_views.PasswordResetConfirmView.as_view(), name='password_reset_confirm'),
    path('reset/done/', auth_views.PasswordResetCompleteView.as_view(), name='password_reset_complete'),
]

urlpatterns = [
    path("test/", lambda request: HttpResponse("Test OK"), name="test"),
    path('', RedirectView.as_view(pattern_name='login', permanent=False), name='home'),
    path('login/', PublicLoginView.as_view(), name='login'),
    path('accounts/', include(auth_urlpatterns)),
    path('immo/', include([
        path('', DashboardView.as_view(), name='home-immo'),
        path('login/', PublicLoginView.as_view(), name='login-immo'),
        path('admin/logout/', CustomLogoutView.as_view(), name='admin_logout'),
        path('admin/', admin.site.urls),
        path('accounts/', include(auth_urlpatterns)),
        path('biens/', include('biens.urls')),
        path('clients/', include('clients.urls')),
        path('rendezvous/', include('rendezvous.urls')),
        path('transactions/', include('transactions.urls')),
        path('chantiers/', include('chantiers.urls')),
        path('comptabilite/', include('comptabilite.urls')),
        path('location/', include('location.urls')),
    ])),
]

if settings.DEBUG:
    urlpatterns += static(settings.MEDIA_URL, document_root=settings.MEDIA_ROOT)
    urlpatterns += static(settings.STATIC_URL, document_root=settings.STATIC_ROOT)
