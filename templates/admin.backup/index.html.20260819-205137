{% extends 'admin/base.html' %}

{% block extra_head %}
<style>
    .admin-card-title {
        color: var(--text-primary, #1e293b) !important;
    }
    .admin-text-muted {
        color: var(--text-secondary, #64748b) !important;
    }
    .admin-card-header {
        background-color: #fff;
        border-bottom: 1px solid #e2e8f0;
    }
    .admin-card-body {
        background-color: #f8fafc;
    }
</style>
{% endblock %}

{% block admin_content %}
<div class="row">
    <div class="col-12">
        <h3 class="mb-4">
            <i class="fas fa-tachometer-alt"></i> Tableau de bord
        </h3>
    </div>
</div>

<div class="row mb-5">
    {% for app in app_list %}
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 border-0 shadow-sm hover-shadow">
            <div class="card-header bg-gradient-primary text-white">
                <h5 class="mb-0">
                    {% if app.name == 'biens' %}
                        <i class="fas fa-building me-2"></i>
                    {% elif app.name == 'clients' %}
                        <i class="fas fa-users me-2"></i>
                    {% elif app.name == 'transactions' %}
                        <i class="fas fa-handshake me-2"></i>
                    {% elif app.name == 'rendezvous' %}
                        <i class="fas fa-calendar me-2"></i>
                    {% elif app.name == 'location' %}
                        <i class="fas fa-map-marker-alt me-2"></i>
                    {% elif app.name == 'marketing' %}
                        <i class="fas fa-bullhorn me-2"></i>
                    {% elif app.name == 'comptabilite' %}
                        <i class="fas fa-calculator me-2"></i>
                    {% else %}
                        <i class="fas fa-folder-open me-2"></i>
                    {% endif %}
                    {{ app.name }}
                </h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    {% for model in app.models %}
                    <li class="mb-3 d-flex justify-content-between align-items-center">
                        <div>
                            {% if model.name == 'bien' %}
                                <i class="fas fa-home text-primary me-2"></i>
                            {% elif model.name == 'client' %}
                                <i class="fas fa-user text-success me-2"></i>
                            {% elif model.name == 'transaction' %}
                                <i class="fas fa-exchange-alt text-warning me-2"></i>
                            {% elif model.name == 'rendezvous' %}
                                <i class="fas fa-calendar-check text-info me-2"></i>
                            {% elif model.name == 'dossiertransaction' %}
                                <i class="fas fa-folder text-secondary me-2"></i>
                            {% else %}
                                <i class="fas fa-table text-primary me-2"></i>
                            {% endif %}
                            <a href="{{ model.admin_url }}" class="text-decoration-none fw-bold text-dark">
                                {{ model.name }}
                            </a>
                            <small class="text-muted d-block">{{ model.object_count }} élément{{ model.object_count|pluralize }}</small>
                        </div>
                        {% if model.add_url %}
                        <a href="{{ model.add_url }}" class="btn btn-sm btn-success rounded-pill">
                            <i class="fas fa-plus"></i>
                        </a>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-lg">
            <div class="card-header bg-gradient-secondary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-chart-bar"></i> Statistiques du système
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-3 mb-4">
                        <div class="p-4 bg-light rounded-3 h-100 d-flex flex-column justify-content-center">
                            <i class="fas fa-building feature-icon text-primary mb-3"></i>
                            <h2 class="display-4 fw-bold text-primary mb-2">{{ total_biens|default:0 }}</h2>
                            <p class="text-muted mb-0 fs-5">Biens immobiliers</p>
                            <small class="text-success fw-semibold">+12% ce mois</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="p-4 bg-light rounded-3 h-100 d-flex flex-column justify-content-center">
                            <i class="fas fa-users feature-icon text-success mb-3"></i>
                            <h2 class="display-4 fw-bold text-success mb-2">{{ total_clients|default:0 }}</h2>
                            <p class="text-muted mb-0 fs-5">Clients actifs</p>
                            <small class="text-success fw-semibold">+8% ce mois</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="p-4 bg-light rounded-3 h-100 d-flex flex-column justify-content-center">
                            <i class="fas fa-handshake feature-icon text-warning mb-3"></i>
                            <h2 class="display-4 fw-bold text-warning mb-2">{{ total_transactions|default:0 }}</h2>
                            <p class="text-muted mb-0 fs-5">Transactions</p>
                            <small class="text-success fw-semibold">+15% ce mois</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-4">
                        <div class="p-4 bg-light rounded-3 h-100 d-flex flex-column justify-content-center">
                            <i class="fas fa-calendar-check feature-icon text-info mb-3"></i>
                            <h2 class="display-4 fw-bold text-info mb-2">{{ total_rendezvous|default:0 }}</h2>
                            <p class="text-muted mb-0 fs-5">Rendez-vous</p>
                            <small class="text-success fw-semibold">+5% ce mois</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card border-0 shadow">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-clock"></i> Activité récente
                </h6>
            </div>
            <div class="card-body">
                <div class="timeline">
                    <div class="timeline-item mb-3">
                        <div class="timeline-marker bg-primary"></div>
                        <div class="timeline-content">
                            <small class="text-muted">Il y a 2h</small>
                            <p class="mb-0"><i class="fas fa-plus-circle text-primary me-2"></i>Nouveau bien ajouté: Villa moderne Dakar</p>
                        </div>
                    </div>
                    <div class="timeline-item mb-3">
                        <div class="timeline-marker bg-success"></div>
                        <div class="timeline-content">
                            <small class="text-muted">Il y a 4h</small>
                            <p class="mb-0"><i class="fas fa-user-plus text-success me-2"></i>Client Dupont inscrit</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-marker bg-warning"></div>
                        <div class="timeline-content">
                            <small class="text-muted">Il y a 6h</small>
                            <p class="mb-0"><i class="fas fa-calendar-plus text-warning me-2"></i>Rendez-vous programmé</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fas fa-exclamation-triangle"></i> Alertes système
                </h6>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Mise à jour disponible
                </div>
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle"></i> 3 mandats expirent bientôt
                </div>
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> Sauvegarde automatique effectuée
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<style>
.bg-gradient-primary {
    background: linear-gradient(45deg, #667eea, #764ba2);
}
.bg-gradient-secondary {
    background: linear-gradient(45deg, #f093fb, #f5576c);
}
.hover-shadow:hover {
    box-shadow: 0 10px 40px rgba(0,0,0,0.1) !important;
    transform: translateY(-2px);
    transition: all 0.3s ease;
}
.timeline {
    position: relative;
    padding-left: 30px;
}
.timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e9ecef;
}
.timeline-item {
    position: relative;
    margin-left: -30px;
    padding-left: 30px;
}
.timeline-marker {
    position: absolute;
    left: 7px;
    top: 5px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 0 0 2px #e9ecef;
}
.timeline-content small {
    display: block;
    margin-bottom: 5px;
}
</style>
{% endblock %}